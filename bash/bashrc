#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias ls='ls --color=auto'
alias grep='grep --color=auto'

# No bell sound on tab completion
bind 'set bell-style none'

# Prompt: machine name and folder
PS1='\[\e[1;32m\]\h\[\e[0m\] \[\e[1;34m\]\w\[\e[0m\] '
# A dim "hc ›" in front when the shell lives in a herdr-core terminal, which outlasts its window
[[ -n $HC_TERMINAL_ID ]] && PS1="\[\e[90m\]hc ›\[\e[0m\] $PS1"

# Tools that install themselves to ~/.local/bin (Claude Code etc)
export PATH="$HOME/.local/bin:$PATH"
# Quitting Claude with background work still running ends it, rather than handing the session to Claude's
# background service, where hc can't see it and lookout loses track of the agent
export CLAUDE_CODE_DISABLE_BG_EXIT_HANDOFF=1

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Machine specific aliases, symlinked by install.sh (machines/<machine>/bashrc.sh)
[[ -f ~/.bashrc.local ]] && . ~/.bashrc.local
